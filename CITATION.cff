cff-version: 1.2.0
message: >-
  If you use BSReadSim in research, please cite the preprint below and report
  the software version.
title: BSReadSim
type: software
authors:
  - family-names: Guo
    given-names: Wenbin
version: 0.4.0
license: MIT
repository-code: https://github.com/wbvguo/BSReadSim
url: https://wbvguo.github.io/BSReadSim/
abstract: >-
  BSReadSim is a deterministic read simulator for bisulfite and standard DNA
  sequencing assays, including WGBS, RRBS, TBS, WGS, WES, and targeted
  sequencing.
keywords:
  - bioinformatics
  - bisulfite sequencing
  - DNA methylation
  - read simulation
preferred-citation:
  type: article
  authors:
    - family-names: Guo
      given-names: Wenbin
    - family-names: Pellegrini
      given-names: Matteo
  title: >-
    BSReadSim: a versatile and efficient simulator to generate realistic
    bisulfite sequencing reads
  doi: "10.1101/2024.12.24.627620"
  journal: bioRxiv
  year: 2024
