.RData
*.Rproj

# Large local datasets and experiment outputs.
# Keep the small top-level experiment/benchmark contracts reviewable while
# ignoring every nested run directory and generated artifact.
data/*
!data/README.md
!data/experiments/
!data/benchmarks/
data/experiments/*
!data/experiments/README.md
!data/experiments/*.py
!data/experiments/*.sh
!data/experiments/*.json
!data/experiments/*.toml
!data/experiments/*.fa
!data/experiments/*.bed
!data/experiments/*.vcf
!data/experiments/*.tsv
data/benchmarks/*
!data/benchmarks/README.md
!data/benchmarks/*.py
!data/benchmarks/*.sh
!data/benchmarks/*.json
!data/benchmarks/*.toml

# Generic generated files
*.log
.cache/
