*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Native build outputs
*.o
*.pico
*.a
*.so
*.so.*

# Notebook, editor, and agent-local state
.ipynb_checkpoints/
.vscode/
